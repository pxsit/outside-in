    },
    "homepage": "https://github.com/pxsit/outside-in",
    "browser": {
        "main": "index.html"
    },
    "devDependencies": {
        "@eslint/css": "^2.0.1",
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.1.1",
        "@eslint/markdown": "^8.0.3",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
